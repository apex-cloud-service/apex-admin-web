# ===== 依赖 =====
node_modules/
.pnpm-store/

# ===== 构建产物 =====
dist/
dist-ssr/
dist-electron/
*.local

# ===== 本地环境变量（不入库）=====
# 所有 .env 文件都不提交到仓库，使用 .env.example 作为配置模板
.env
.env.*
!.env.example

# ===== Vite / 编译缓存 =====
.vite/
*.tsbuildinfo
*.d.ts.tsbuildinfo

# ===== 编辑器与系统文件 =====
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.DS_Store
Thumbs.db
desktop.ini

# ===== 日志 =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===== 测试与覆盖率 =====
coverage/
coverage-html/
.nyc_output/

# ===== 测试报告 =====
# 机器可读结果（JUnit XML / 用例 JSON / 覆盖率摘要）入库，供 CI 归档与比对；
# HTML、lcov 等生成物体积大且可随时重建，不入库。
# E2E（Playwright）JUnit 结果与单元测试同口径入库；lighthouse/stress 生成物不入库。
reports/*
!reports/test-results.xml
!reports/test-results.json
!reports/e2e-results.xml
!reports/coverage/
reports/coverage/*
!reports/coverage/coverage-summary.json

# ===== 测试缓存 =====
test-results/
.playwright/
.cache/

# ===== 编辑器缓存 =====
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ===== 工具链本地状态 =====
.workbuddy/
.trae/
.trae-html-share-packages/
.zcode/

# ===== 本地运行日志（后端服务在联调时可能写入工作目录） =====
/logs/

# ===== 备份和临时文件 =====
*.bak
diagnostic.html

# ===== AI 工具私有目录（规则见 AGENTS.md 第 0 章 0.3）=====
# 只允许存放各 AI 工具的规则/配置/缓存/记忆；
# 业务文档、方案、报告一律写入 docs/，禁止在本目录留存正文。
.workbuddy/
.trae/
.trae-html-share-packages/
.zcode/
.qoder/
.codex/
.agents/
.ai/
.claude/
# 注意：docs/ 必须全量入库，禁止添加任何忽略 docs 的规则
