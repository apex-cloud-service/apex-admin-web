# ===== 依赖 =====
node_modules/
.pnpm-store/

# ===== 构建产物 =====
dist/
dist-ssr/
dist-electron/
*.local

# ===== 本地环境变量（不入库）=====
# 所有 .env 文件都不提交到仓库，使用 .env.example 作为配置模板
.env
.env.*
!.env.example

# ===== Vite / 编译缓存 =====
.vite/
*.tsbuildinfo
*.d.ts.tsbuildinfo

# ===== 编辑器与系统文件 =====
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.DS_Store
Thumbs.db
desktop.ini

# ===== 日志 =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===== 测试与覆盖率 =====
coverage/
coverage-html/
.nyc_output/

# ===== 测试报告 =====
# 机器可读结果（JUnit XML / 用例 JSON / 覆盖率摘要）入库，供 CI 归档与比对；
# HTML、lcov 等生成物体积大且可随时重建，不入库。
# E2E（Playwright）JUnit 结果与单元测试同口径入库；lighthouse/stress 生成物不入库。
reports/*
# 入库白名单：目录说明 + 机器可读汇总件（其余全部可重建、不入库）
!reports/README.md
!reports/e2e/e2e-results.xml
!reports/unit/test-results.xml
!reports/unit/test-results.json
!reports/coverage/
reports/coverage/*
!reports/coverage/coverage-summary.json

# ===== 测试缓存 =====
test-results/
.playwright/
.cache/

# ===== 编辑器缓存 =====
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 注：AI 私有目录（.workbuddy/.trae/.trae-html-share-packages/.zcode/.qoder/.codex/.claude/.agents/.ai）
#     统一在文件末尾单一区块维护，此处不再重复。

# ===== 本地运行日志（后端服务在联调时可能写入工作目录） =====
/logs/

# ===== 备份和临时文件 =====
*.bak
diagnostic.html

# ===== AI 工具私有目录（规则见 AGENTS.md 第 0 章 0.4；唯一区块，勿在别处重复）=====
# 只允许存放各 AI 工具的规则/配置/缓存/记忆；业务文档、方案、报告一律写入 docs/。
# 注：.gitignore 的注释必须独占一行，不能写在规则行尾（行尾 # 会被当作规则的一部分）。
# WorkBuddy 会话与记忆（正文见 docs/reference/ai-knowledge/）
.workbuddy/
# Trae 会话与文档草稿（正文见 docs/）
.trae/
# Trae 分享包缓存
.trae-html-share-packages/
# ZCode 计划与会话（正文见 docs/plans/）
.zcode/
# Qoder 工作区
.qoder/
# Codex 工作区
.codex/
# Claude 工作区
.claude/
# 通用 Agent 定义与缓存
.agents/
# 其他 AI 工具目录
.ai/
# 注意：docs/ 必须全量入库，禁止添加任何忽略 docs 的规则
# 隔离验证运行时产物（TLS 证书、临时授权材料路径；内容为本地自签材料，禁止入库）
.runtime/
