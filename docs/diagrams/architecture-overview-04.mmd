flowchart LR
    SRC["源码 + 构建期 VITE_*<br/>（.env.production / --build-arg）"] --> TC["vue-tsc --noEmit<br/>类型检查（构建前置，失败即终止）"]
    TC --> BUILD["vite build<br/>terser（drop_console/debugger）<br/>manualChunks 分包"]
    BUILD --> DIST["dist/<br/>js/ css/ images/ fonts/ media/ + stats.html"]

    DIST --> N1["部署形态 A：静态托管 + Nginx"]
    DIST --> IMG1["部署形态 B：容器镜像"]

    subgraph Runtime["运行期注入（不重写已打包 JS）"]
        ENV1["API_PROXY_PASS<br/>（Nginx upstream）"]
        ENV2["TLS 证书 / 端口映射"]
    end

    ENV1 --> TPL["container-entrypoint.sh<br/>envsubst 仅展开 API_PROXY_PASS"]
    TPL --> CONF["/etc/nginx/conf.d/default.conf"]
    CONF --> NGX

    IMG1 --> IMG2["多阶段镜像<br/>build：node:22-alpine + npm ci + npm run build<br/>runtime：nginx:1.27-alpine"]
    IMG2 --> NGX["Nginx 静态服务"]

    N1 --> NGX
    NGX --> A1["assets/ 30 天 immutable"]
    NGX --> A2["location / try_files 回退 index.html<br/>支撑 history 路由"]
    NGX --> A3["精确 location：<br/>= /api/v1/messages/ws（Upgrade，3600s）<br/>= /api/v1/notifications/stream（SSE，buffering off）<br/>置于 /api/ 之前"]
    NGX --> A4["前缀反代：/api/ · /admin-api/ · /auth/v1|v2/<br/>/integration/v1/ · /oauth2/（consent 仅 POST）"]
    A4 --> BE["后端网关 upstream<br/>默认 http://apex-gateway:8080"]

    HC["容器 HEALTHCHECK：wget /<br/>仅证明静态首页可访问"] -.不覆盖.-> A4