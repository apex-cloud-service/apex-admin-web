flowchart LR
    SRC["源码 + .env.production"] --> B1["构建阶段：node:22-alpine<br/>npm ci（锁文件安装）"]
    ARG["--build-arg VITE_API_BASE_URL"] -.-> B1
    B1 --> TC["npm run build = vue-tsc --noEmit && vite build"]
    TC --> DIST["dist/"]

    DIST --> R1["运行阶段：nginx:1.27-alpine<br/>ENV TZ=Asia/Shanghai"]

    TPL["container/nginx.conf<br/>（作为 default.conf.template）"] --> R1
    EPF["container/container-entrypoint.sh"] --> R1
    ENV1["运行期环境变量<br/>API_PROXY_PASS（默认 http://apex-gateway:8080）"] --> EP["entrypoint：envsubst<br/>仅展开 API_PROXY_PASS"]
    EP --> CONF["/etc/nginx/conf.d/default.conf"]
    R1 --> CONF
    CONF --> UP["后端 upstream"]

    R1 --> HC["容器 HEALTHCHECK<br/>wget http://127.0.0.1/"]
    HC -.仅证明.-> HC2["静态首页可访问<br/>不代表 API 反代 / 后端 / WS 可用"]

    CMP["全栈编排：后端仓库 podman-compose.yml<br/>外部网络 apex-scaffold_apex-network"] -.-> R1
    NOTE["VITE_API_BASE_URL 在构建期注入<br/>运行时修改不能重写已打包 JS"] -.-> ARG