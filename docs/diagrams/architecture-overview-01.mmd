flowchart TB
    subgraph Browser["用户浏览器"]
        SPA["Apex Admin Web SPA<br/>Vue 3.5 + Vite 6 构建产物"]
    end

    subgraph Transport["本仓库交付的传输层"]
        AX["utils/request.ts<br/>Axios：解包 Result / 401 单飞刷新 / 30s 超时"]
        XHR["ElUpload + 独立 XHR<br/>不经过 Axios 拦截器"]
        SSE["fetch 流式读取<br/>通知中心 / KB 问答"]
        WS["WebSocket<br/>站内信推送"]
    end

    subgraph Gateway["开发代理 (Vite :5173) / 生产反代 (Nginx)"]
        G0["精确匹配<br/>= /api/v1/messages/ws（Upgrade）<br/>= /api/v1/notifications/stream（SSE）"]
        G1["/api/**（开发代理开 ws:true）"]
        G2["/admin-api/**"]
        G3["/auth/v1/** 、/auth/v2/**"]
        G4["/integration/v1/**"]
        G5["/oauth2/authorize、/oauth2/token<br/>/oauth2/consent（仅 POST 反代，GET 回退 SPA）"]
    end

    subgraph Backend["Apex Scaffold 后端（Spring Boot 3 WebFlux, :8080）"]
        B1["业务 /api/v1/**<br/>认证·用户·文件·Office 接入·站内信·通知中心·脱敏·KB 检索"]
        B2["管理 /admin-api/v1/**<br/>系统·监控·日志·SSO·生成器·认证配置·消息模板·组织·KB 管理"]
        B3["办公业务 /api/office/**<br/>审批·日历·文档"]
        B4["工作流高级操作 /api/workflow/**<br/>回退·转办·委派·挂起·恢复"]
        B5["平台与扩展域 /api/v2/**<br/>租户·套餐·能力·总览·工作流定义·运维健康·会议室·同步向导·统一通知·文件分享"]
        B6["集成与物联网 /integration/v1/**<br/>连接器·凭据·IoT 设备/规则<br/>（/internal/v1/** 内部端点网关 403）"]
        B7["认证中心 /auth/v1|v2/**<br/>登录·MFA·刷新·在线会话·密码找回"]
        B8["安全能力 /api/mfa/**、/api/ip-access-control/**<br/>/api/v1/auth/audit-logs/**"]
        B9["依赖服务<br/>全文搜索 · 飞书/钉钉/企微 · OAuth2 提供商"]
    end

    SPA --> AX & XHR & SSE & WS
    AX --> G1 & G2 & G3 & G4 & G5
    XHR --> G1
    SSE --> G0
    WS --> G0
    G0 --> B1
    G1 --> B1 & B3 & B4 & B5 & B9
    G2 --> B2 & B5 & B9
    G3 --> B7
    G4 --> B6
    G5 --> B9 & B7
    B8 -.同域 /api 前缀.-> G1