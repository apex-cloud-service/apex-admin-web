flowchart TB
    subgraph Entry["应用入口"]
        E1["main.ts<br/>createApp + Pinia + Router + Element Plus<br/>+ v-permission 指令"]
        E2["App.vue → router-view"]
    end

    subgraph Views["视图层 src/views（65 个 .vue）"]
        V1["动态路由页（51 项 VIEW_REGISTRY）<br/>system(18) · monitor(9) · office(10) · knowledge(4)<br/>data(3) · integration/iot(3) · workflow(2) · 其他(2)"]
        V2["静态路由页<br/>login · oauth2/{callback,consent} · office/callback<br/>password-recovery · share · dashboard<br/>workflow/monitor(+instances/:id) · demo×2 · 404"]
    end

    subgraph Layout["布局与通用组件"]
        L1["layouts/AdminLayout.vue<br/>侧边栏（Root 子项过滤 title/hidden）<br/>顶栏 · 面包屑 · 主题 · 未读角标 · 权限码告警"]
        L2["components/<br/>Pagination · FileUpload · FileUploadEnhanced<br/>GlobalSearch · NotificationCenter · EmptyState"]
    end

    subgraph State["状态层 src/stores（Pinia Setup Store）"]
        S1["user：token/identity/permissions/initialized<br/>login · verifyMfaChallenge · loadIdentity"]
        S2["permission：由 user.permissions 派生<br/>空集合放行"]
        S3["app：sidebarCollapsed / theme（经 utils/storage）"]
        S4["office：平台与绑定状态（仅测试引用，未接入页面）"]
    end

    subgraph Compose["组合式函数 src/composables"]
        C1["useAgenda（工作台五域聚合，已接线）<br/>useCrud · useTableConfig · useFormDraft<br/>useBreakpoint（已实现，useCrud 无页面调用）"]
    end

    subgraph Api["接口层 src/api（40 个模块）"]
        A1["按业务域拆分的类型化函数"]
    end

    subgraph Infra["基础设施 src/utils"]
        I1["request.ts：Axios 实例 + 解包 + 401 单飞刷新"]
        I2["auth.ts：会话存取（唯一入口）<br/>settings.ts：键名与常量"]
        I3["api-base.ts：非 Axios 通道的地址拼接<br/>notification-stream.ts · message-socket.ts"]
        I4["其余：mask · xss-protection · validate(-rules)<br/>request-cache · error-handler · echarts-theme"]
    end

    E1 --> E2
    E2 --> L1
    L1 --> V1 & V2
    V1 & V2 --> L2
    V1 & V2 --> S1 & S2 & S3 & S4
    V1 & V2 --> C1
    V1 & V2 & L2 & C1 --> A1
    A1 --> I1
    A1 --> I3
    S1 & S2 --> I2
    I1 --> I2
    C1 --> A1
    S1 --> A1
    L1 --> S3
    I1 --> I4