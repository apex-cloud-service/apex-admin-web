classDiagram
    direction LR

    class Result~T~ {
        +number code
        +string msg
        +T data
        +string traceId
    }
    class PageResponse~T~ {
        +T[] list
        +number total
        +number pageNum
        +number pageSize
        +number pages
        +boolean hasNext
    }

    class AdminUser {
        +string id
        +string nickname
        +string avatarUrl
        +number gender
        +string phone
        +number status
        +string onboardingStatus
        +string activityStatus
        +string lastLoginTime
        +string createdAt
        +AdminRole[] roles
    }
    class AdminUserDetail {
        +string birthday
        +string country
        +string province
        +string city
        +string language
        +string lastHeartbeatTime
        +string updatedAt
        +Record profile
        +Record profileDetails
    }
    class AdminRole {
        +string id
        +string name
        +string code
    }
    class StaffRole {
        +string id
        +string name
        +string code
    }
    class MenuNode {
        +number id
        +number parentId
        +string menuName
        +number menuType
        +string path
        +string component
        +string perms
        +string icon
        +number sort
        +number visible
        +number status
        +string createTime
        +MenuNode[] children
    }
    class DeptNode {
        +number id
        +number parentId
        +string name
        +number orderNum
        +string leader
        +string phone
        +string email
        +number status
        +DeptNode[] children
    }

    class TenantInfo {
        +number id
        +string tenantCode
        +string tenantName
        +string packageCode
        +string expireTime
        +string status
        +number maxUsers
        +number maxStorageMb
        +number version
    }
    class TenantPackage {
        +number id
        +string packageCode
        +string packageName
        +number[] menuIds
        +string[] permissionCodes
        +string[] features
        +number status
        +number version
    }
    class CapabilityInfo {
        +string code
        +string name
        +string center
        +string component
        +string[] openScopes
    }

    class WorkflowInstance {
        +number id
        +number definitionId
        +string processCode
        +string title
        +string status
        +number initiatorId
        +string initiatorName
        +string businessKey
        +string currentNodeId
        +string startTime
        +string endTime
        +string createTime
        +boolean suspended
    }
    class WorkflowTask {
        +number id
        +number instanceId
        +string taskName
        +string status
        +number assigneeId
        +string assigneeName
    }
    class OfficeBindingResponse {
        +number id
        +number userId
        +string platform
        +string externalUserId
        +string status
        +number version
    }

    Result~T~ <.. PageResponse~T~ : 分页响应包装
    AdminUserDetail --|> AdminUser : 继承
    AdminUser "1" o-- "0..*" AdminRole : roles
    MenuNode "1" *-- "0..*" MenuNode : children（递归树）
    DeptNode "1" *-- "0..*" DeptNode : children（递归树）
    TenantInfo ..> TenantPackage : packageCode 引用
    TenantPackage ..> CapabilityInfo : features 订阅
    WorkflowInstance "1" *-- "0..*" WorkflowTask : tasks（详情聚合）
    AdminUser ..> OfficeBindingResponse : userId 关联

    note for TenantPackage "menuIds/permissionCodes 空集合 = 全量放行\nfeatures 空集合 = 未订阅"
    note for MenuNode "menuType: 0 目录 / 1 菜单 / 2 按钮\nvisible: 0 隐藏 / 1 显示\nstatus 不参与路由过滤"
    note for Result "不含数字 code 的响应（裸数组/Blob/登录裸响应）\n由 request.ts 原样返回，不套此壳"