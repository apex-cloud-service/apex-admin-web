flowchart TD
    A["路由跳转触发 beforeEach"] --> B{"to.meta.public?"}
    B -- 是 --> Z["直接放行<br/>login · oauth2/callback · oauth2/consent<br/>office/callback · password-recovery · share"]
    B -- 否 --> C{"getToken() 存在?"}
    C -- 否 --> D["重定向 /login<br/>携带 query.redirect = to.fullPath"]
    C -- 是 --> E{"user.initialized?"}
    E -- 否 --> F["loadIdentity()<br/>并行：user/info + roles/my + permissions/my"]
    F --> G{"加载成功?"}
    G -- 否 --> H["clearLocal() 并跳转 /login<br/>该分支不携带 redirect"]
    G -- 是 --> J
    E -- 是 --> J{"dynamicRoutesAdded?"}
    J -- 否 --> K["setupDynamicRoutes()<br/>菜单树 → VIEW_REGISTRY → addRoute('Root')"]
    K --> K1{"注册抛错?"}
    K1 -- 是 --> K2["逆序回滚已 addRoute 的路由<br/>console.warn 降级为静态路由"]
    K1 -- 否 --> L
    K2 --> L["解析目标 fullPath"]
    J -- 是 --> L
    L --> M{"to.name 为 NotFound<br/>且 resolve(fullPath) 已可匹配?"}
    M -- 是 --> N["replace 到真实路径<br/>保留 query / hash"]
    M -- 否 --> Z2["放行"]
    N --> Z2
    K -.-> NOTE2["双重检查：并发/重入时仅首个完成注册<br/>失败后 dynamicRoutesAdded 仍为 false，后续导航可重试"]