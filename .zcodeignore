.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.DS_Store
Thumbs.db
desktop.ini

# ===== 日志 =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===== 测试与覆盖率 =====
coverage/
coverage-html/
.nyc_output/

# ===== 测试缓存 =====
test-results/
.playwright/
.cache/

# ===== 编辑器缓存 =====
