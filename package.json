{
  "name": "apex-admin-web",
  "version": "1.2.0",
  "private": true,
  "description": "Apex Scaffold 管理后台前端（前后端分离）— Vue3 + Vite + TypeScript + Pinia + Element Plus",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:report": "vitest run --coverage --coverage.reportsDirectory=reports/coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=json-summary --coverage.reporter=html --coverage.reporter=lcov --reporter=default --reporter=junit --outputFile.junit=reports/test-results.xml --reporter=json --outputFile.json=reports/test-results.json && node scripts/quality/normalize-test-report.mjs",
    "check:comments": "node scripts/quality/check-comments.mjs",
    "verify:deploy": "bash scripts/verify/post-deploy-check.sh",
    "analyze": "vite build && open dist/stats.html",
    "generate:api": "openapi-generator-cli generate",
    "audit": "npm audit --json | npm-audit-html --output ./reports/audit.html",
    "audit:fix": "npm audit fix"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "cropperjs": "^1.6.3",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@playwright/test": "^1.63.0",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "@vue/test-utils": "^2.5.0",
    "cli-progress": "^3.12.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "mockjs": "^1.1.0",
    "npm-audit-html": "^1.5.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.104.1",
    "snyk": "^1.1307.2",
    "terser": "^5.51.2",
    "typescript": "~5.7.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.7",
    "vitest": "^5.0.1",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true
  }
}
