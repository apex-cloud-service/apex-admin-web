# EditorConfig：统一各编辑器/IDE 编码风格
# 前端工程规范：Vue3/TS 2 空格 / 缩进用空格 / LF 行尾 / UTF-8

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,tsx,vue,js,jsx}]
indent_size = 2
indent_style = space
tab_width = 2

[*.{json,yml,yaml}]
indent_size = 2
indent_style = space
tab_width = 2

[*.{html,css,scss,less}]
indent_size = 2
indent_style = space

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
