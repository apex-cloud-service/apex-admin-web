# 环境变量配置模板
# ------------------------------------------------------------------
# 使用说明：
#   1. 开发环境：cp .env.example .env.development
#   2. 生产环境：cp .env.example .env.production
#   3. 根据实际情况修改配置值
#   4. 不要将 .env.development 或 .env.production 提交到 Git 仓库

# ========== 后端服务配置 ==========

# 后端服务地址（仅开发环境使用）
# 开发时 Vite 会将 /api 和 /admin-api 请求代理到此地址
# 示例：http://127.0.0.1:8080 或 http://192.168.1.100:8080
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# 生产环境后端网关地址（仅生产环境使用）
# 如果前后端同域部署（通过 Nginx 分流），保持为空
# 如果跨域部署，填写后端完整地址，例如：https://api.example.com
VITE_API_BASE_URL=

# ========== OAuth2 认证配置 ==========

# OAuth2 客户端 ID
# 用途：用于第三方登录（微信、GitHub 等）的客户端标识
# 重要：此 ID 必须与后端 OAuth2 配置中的 client_id 完全一致
# 
# 配置建议：
#   - 开发环境：apex-admin-web-dev
#   - 生产环境：apex-admin-web-prod
#   - 测试环境：apex-admin-web-test
# 
# 如何获取：请联系后端团队获取对应环境的客户端 ID
VITE_OAUTH2_CLIENT_ID=apex-admin-web

# ========== 其他配置（预留） ==========

# 如需添加其他环境变量，请在此处添加并同步更新 README.md


# ========== 多租户认证配置 ==========

# 是否启用登录页"租户标识"输入框（多租户部署时设为 true）
# 启用后登录请求会携带 tenantId 字段（仅作租户匹配声明，不能切换租户；
# 后端缺省使用 default 租户）。单体部署保持为空或 false 即可。
VITE_AUTH_TENANT_ENABLED=
